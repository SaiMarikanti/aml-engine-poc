# Databricks SQL Warehouse Connection Configuration
# Copy this file to .env and fill in your values

# 1. Server Hostname (e.g. dbc-a1b2c3d4-e5f6.cloud.databricks.com without https://)
DATABRICKS_HOST=your-workspace.cloud.databricks.com

# 2. Personal Access Token (PAT) or Service Principal Token (dapi...)
DATABRICKS_TOKEN=dapixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. HTTP Path of your SQL Warehouse (from SQL Warehouse -> Connection details)
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx

# 4. Unity Catalog Catalog & Schema where Gold Delta tables reside
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=aml_gold

# 5. Set to 'false' to connect to Databricks (or leave unset); set to 'true' to force local SQLite
FORCE_LOCAL_LAKEHOUSE=false
