# Databricks SQL Warehouse Connection Configuration
# Copy this file to .env and fill in your values

# 1. Server Hostname (e.g. dbc-a1b2c3d4-e5f6.cloud.databricks.com without https://)
DATABRICKS_HOST=your-workspace.cloud.databricks.com

# 2. SQL Warehouse Resource (Serverless Starter Warehouse ID)
DATABRICKS_WAREHOUSE_ID=xxxxxxxxxxxxxxxx
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx

# 3. Personal Access Token (PAT) - Optional in Databricks Apps (auto-authenticated via OAuth service principal)
DATABRICKS_TOKEN=dapixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 4. Target Unity Catalog & Schema (from verified workspace environment)
DATABRICKS_CATALOG=aml_engine
DATABRICKS_SCHEMA=aml_poc

# 5. Execution mode: 'databricks' (default) or 'local' (offline adapter)
AML_MODE=databricks
