# Streamlit Secrets configuration for Databricks
# Save as .streamlit/secrets.toml for automatic local injection by Streamlit

[databricks]
host = "your-workspace.cloud.databricks.com"
token = "dapixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
warehouse_id = "xxxxxxxxxxxxxxxx"
http_path = "/sql/1.0/warehouses/xxxxxxxxxxxxxxxx"
catalog = "aml_engine"
schema = "aml_poc"
